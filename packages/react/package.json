{
  "name": "@gardenerim/react",
  "version": "2.1.0",
  "description": "Official React bindings for the Gardenerim CSS framework and runtime.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepcase/gardenner.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/deepcase/gardenner/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/deepcase/gardenner/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "metadata",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/generated/components.d.ts",
      "import": "./dist/generated/components.js",
      "default": "./dist/generated/components.js"
    },
    "./component": {
      "types": "./dist/component.d.ts",
      "import": "./dist/component.js",
      "default": "./dist/component.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js",
      "default": "./dist/hooks.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js",
      "default": "./dist/provider.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js",
      "default": "./dist/adapters.js"
    },
    "./tauri": {
      "types": "./dist/tauri.d.ts",
      "import": "./dist/tauri.js",
      "default": "./dist/tauri.js"
    },
    "./electron": {
      "types": "./dist/electron.d.ts",
      "import": "./dist/electron.js",
      "default": "./dist/electron.js"
    },
    "./catalog": {
      "types": "./dist/generated/catalog.d.ts",
      "import": "./dist/generated/catalog.js",
      "default": "./dist/generated/catalog.js"
    },
    "./catalog.json": "./dist/catalog.json",
    "./style.css": "./dist/style.css",
    "./core.css": "./dist/core.css",
    "./themes.css": "./dist/themes.css",
    "./utilities.css": "./dist/utilities.css",
    "./components.css": "./dist/components.css",
    "./ai.css": "./dist/ai.css",
    "./platform/web.css": "./dist/platform/web.css",
    "./platform/mobile.css": "./dist/platform/mobile.css",
    "./platform/desktop.css": "./dist/platform/desktop.css",
    "./platform/tauri.css": "./dist/platform/tauri.css",
    "./platform/electron.css": "./dist/platform/electron.css",
    "./component-css/*.css": "./dist/component-css/*.css",
    "./component-css/*": "./dist/component-css/*.css",
    "./bundle.min.js": {
      "types": "./dist/index.d.ts",
      "import": "./dist/gardener-react.min.js",
      "default": "./dist/gardener-react.min.js"
    },
    "./performance": "./dist/gardener-react.performance.json",
    "./schema/public-api": "./metadata/public-api.schema.json",
    "./schema/compatibility": "./metadata/compatibility.schema.json",
    "./schema/performance": "./metadata/performance.schema.json",
    "./package.json": "./package.json",
    "./contracts": {
      "types": "./dist/generated/contracts.d.ts",
      "import": "./dist/generated/contracts.js",
      "default": "./dist/generated/contracts.js"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "generate": "node scripts/generate.mjs",
    "build": "npm run clean && npm run generate && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "build:example": "vite build",
    "check": "node scripts/check.mjs",
    "budget": "node scripts/budget.mjs",
    "verify:reproducible": "node scripts/verify-reproducible.mjs",
    "verify:treeshaking": "node scripts/verify-treeshaking.mjs",
    "verify:package": "node scripts/verify-package.mjs && publint",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:schema": "node --test --test-concurrency=1 tests/schema.test.mjs",
    "test:unit": "node --test --test-concurrency=1 tests/contracts.test.mjs tests/runtime.test.mjs",
    "test:browser": "playwright test --project=desktop-chromium --project=desktop-webkit --project=mobile-chromium --project=mobile-webkit",
    "test:browser:firefox": "node scripts/test-firefox.mjs",
    "test:a11y": "playwright test --project=accessibility-chromium",
    "test:e2e": "npm run test:browser && npm run test:browser:firefox && npm run test:a11y",
    "test": "npm run build && npm run check && npm run budget && npm run test:schema && npm run test:types && npm run test:unit && npm run build:example && npm run test:e2e && npm run verify:treeshaking && npm run verify:reproducible && npm run verify:package",
    "release:verify": "npm test",
    "prepublishOnly": "npm run release:verify",
    "dev": "vite"
  },
  "peerDependencies": {
    "@gardenerim/css": ">=2.1.0 <3.0.0",
    "react": ">=18.3.0 <20.0.0",
    "react-dom": ">=18.3.0 <20.0.0"
  },
  "devDependencies": {
    "@gardenerim/css": "file:../css",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.0.1",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.11.12",
    "publint": "0.3.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "keywords": [
    "react",
    "gardener",
    "css-framework",
    "component-library",
    "design-system",
    "dashboard",
    "mobile",
    "ai-ui",
    "tauri",
    "electron"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
