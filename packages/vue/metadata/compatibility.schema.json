{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gardener.dev/schema/vue/compatibility-1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "version", "baselineVersion", "policy", "baseline"],
  "properties": {
    "$schema": { "const": "./compatibility.schema.json" },
    "schemaVersion": { "const": 1 },
    "version": { "const": "1.0.0" },
    "baselineVersion": { "const": "1.0.0" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "additions", "removals"],
      "properties": {
        "stage": { "const": "stable" },
        "additions": { "const": "allowed" },
        "removals": { "const": "deprecate-before-removal" }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageEntrypoints", "componentNames", "componentExports", "moduleExports", "typeExports", "behaviors", "composables", "componentProps", "componentInstanceMembers", "themeAxes", "pluginOptions"],
      "properties": {
        "packageEntrypoints": { "type": "array", "minItems": 28, "uniqueItems": true, "items": { "type": "string" } },
        "componentNames": { "type": "array", "minItems": 506, "maxItems": 506, "uniqueItems": true, "items": { "type": "string" } },
        "componentExports": { "type": "array", "minItems": 506, "maxItems": 506, "uniqueItems": true, "items": { "type": "string", "pattern": "^G" } },
        "moduleExports": { "type": "array", "minItems": 538, "maxItems": 538, "uniqueItems": true, "items": { "type": "string" } },
        "typeExports": { "type": "array", "minItems": 21, "uniqueItems": true, "items": { "type": "string" } },
        "behaviors": { "type": "array", "minItems": 66, "maxItems": 66, "uniqueItems": true, "items": { "type": "string" } },
        "composables": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string" } },
        "componentProps": { "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": { "type": "string" } },
        "componentInstanceMembers": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "type": "string" } },
        "themeAxes": { "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": { "type": "string" } },
        "pluginOptions": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}
