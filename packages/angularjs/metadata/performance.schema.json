{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "version", "status", "artifact", "metrics"],
  "properties": {
    "$schema": { "type": "string" }, "schemaVersion": { "const": 1 }, "version": { "const": "2.1.0" }, "status": { "const": "passed" }, "artifact": { "const": "gardener-angularjs.min.js" },
    "metrics": { "type": "object", "additionalProperties": false, "required": ["raw", "gzip", "brotli"], "properties": { "raw": { "type": "integer", "minimum": 1 }, "gzip": { "type": "integer", "minimum": 1 }, "brotli": { "type": "integer", "minimum": 1 } } }
  }
}
