@page "/desktop"
@using System.Text.Json
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>桌面端 组件 · Blazor</PageTitle>
<link rel="stylesheet" href="desktop-demo.css" />
<h1>桌面端 组件 · Blazor</h1>
<p>工作空间、窗口、文档、任务与系统状态；使用本地模拟服务。</p>
<label>组件<select id="desktop-kind" @bind="Name" @bind:after="Reset">@foreach(var name in Names){<option>@name</option>}</select></label>
<label>变体<select id="desktop-mode" @bind="Mode" @bind:after="ResetState">@foreach(var mode in Examples.RootElement.GetProperty(Name).EnumerateObject()){<option>@mode.Name</option>}</select></label>

<label>呈现方式<select id="desktop-presentation" @bind="Presentation" @bind:after="ResetState"><option value="inline">内嵌</option><option value="modal">弹窗（命令面板 / 关于）</option></select></label>
<button class="g-btn" id="desktop-size" @onclick="ToggleSize">切换尺寸</button>
<div class="desktop-demo-host"><GardenerimComponent @key="Name+Mode" Name="@Name" Variant="@Mode" Config="Options" EventNames="@(new[]{"change","action","complete","error"})" OnEvent="Changed" id="desktop-root" /><output class="desktop-demo-result"></output><output id="desktop-state">@Result</output></div>
