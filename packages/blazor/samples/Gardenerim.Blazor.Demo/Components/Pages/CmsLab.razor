@page "/cms"
@using System.Text.Json
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>CMS 组件 · Blazor</PageTitle>
<link rel="stylesheet" href="cms-demo.css" />
<h1>CMS 组件 · Blazor</h1>
<p>结构化内容、媒体选择、审核与翻译；使用本地模拟服务。</p>
<label>组件<select id="cms-kind" @bind="Name" @bind:after="Reset">@foreach(var name in Names){<option>@name</option>}</select></label>
<label>变体<select id="cms-mode" @bind="Mode" @bind:after="ResetState">@foreach(var mode in Examples.RootElement.GetProperty(Name).EnumerateObject()){<option>@mode.Name</option>}</select></label>

<button class="g-btn" id="cms-size" @onclick="ToggleSize">切换尺寸</button>
<div class="cms-demo-host"><GardenerimComponent @key="Name+Mode" Name="@Name" Variant="@Mode" Config="Options" EventNames="@(new[]{"change","action","complete","error"})" OnEvent="Changed" id="cms-root" /><output class="cms-demo-result"></output><output id="cms-state">@Result</output></div>
