@page "/statistic"
@using System.Text.Json
<PageTitle>GStatistic</PageTitle>
<section style="max-width:800px;margin:24px auto;padding:16px"><h1>GStatistic</h1><label>精度 <select aria-label="精度" @bind="Precision"><option>0</option><option>1</option><option>2</option><option>3</option></select></label><label><input type="checkbox" @bind="Grouped" />千分位</label><div style="display:flex;gap:32px;flex-wrap:wrap;margin-block:24px"><GStatistic id="statistic" Config="Config" /><GStatistic id="countdown" Config="Countdown" EventNames="@(new[]{"complete"})" OnEvent="Complete" /></div><button type="button" class="g-btn" @onclick="()=>Amount+=2500">增加 2500</button><button type="button" class="g-btn" @onclick="Restart">倒计时 3 秒</button><output aria-live="polite">@Result</output></section>
@code {private double Amount=26842.75;private int Precision=2;private bool Grouped=true,Started=false;private long Deadline=DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()+60000;private string Result="";private IReadOnlyDictionary<string,object?> Config=>new Dictionary<string,object?>{["data-options"]=JsonSerializer.Serialize(new{title="本月收入",value=Amount,precision=Precision,showGroupSeparator=Grouped,prefix="¥",extra="五端共享数字格式"})};private IReadOnlyDictionary<string,object?> Countdown=>new Dictionary<string,object?>{["data-options"]=JsonSerializer.Serialize(new{title="活动倒计时",mode="countdown",value=Deadline,start=Started})};private void Restart(){Deadline=DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()+3000;Started=true;Result="";}private void Complete(Gardenerim.Blazor.Models.GardenerimEventArgs e){Result="倒计时已结束";Started=false;}}
