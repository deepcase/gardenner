@page "/solution"
@using System.Text.Json
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>解决方案 组件 · Blazor</PageTitle>

<h1>解决方案 组件 · Blazor</h1>
<p>32 个可配置页面，支持栏目、筛选、表单与异步服务。</p>
<label>组件<select id="solution-kind" @bind="Name" @bind:after="Reset">@foreach(var name in Names){<option>@name</option>}</select></label>
<label>变体<select id="solution-mode" @bind="Mode" @bind:after="ResetState">@foreach(var mode in Examples.RootElement.GetProperty(Name).EnumerateObject()){<option>@mode.Name</option>}</select></label>

<button class="g-btn" id="solution-size" @onclick="ToggleSize">切换尺寸</button>
<div class="solution-demo-host"><GardenerimComponent @key="Name+Mode" Name="@Name" Variant="@Mode" Config="Options" EventNames="@(new[]{"change","action","complete","error"})" OnEvent="Changed" id="solution-root" /><output class="solution-demo-result"></output><output id="solution-state">@Result</output></div>
