@page "/tag"
@using System.Text.Json
<PageTitle>GTag</PageTitle>
<section style="max-width:800px;margin:24px auto;padding:16px"><h1>GTag</h1><label>尺寸 <select aria-label="尺寸" @bind="Size">@foreach(var value in new[]{"mini","small","medium","large"}){<option>@value</option>}</select></label><button @onclick="()=>Visible=true">恢复标签</button><div style="padding:20px;margin-block:24px;border:1px solid var(--g-color-border)"><GTag id="tag" Config="Config" EventNames="@(new[]{"check","close"})" OnEvent="Handle" /></div><output aria-live="polite">@Result</output></section>
@code{private string Size="medium",Result="尚未操作";private bool Checked=true,Visible=true;private IReadOnlyDictionary<string,object?> Config=>new Dictionary<string,object?>{["tag-options"]=JsonSerializer.Serialize(new{text="项目标签",size=Size,color="arcoblue",checkable=true,closable=true,@checked=Checked,visible=Visible,closeLabel="关闭标签"})};private void Handle(Gardenerim.Blazor.Models.GardenerimEventArgs e){if(e.EventName.Replace("gardener:","")=="close"){Visible=false;Result="已关闭";}else if(e.Detail is IReadOnlyDictionary<string,object?> detail&&detail.TryGetValue("checked",out var value)){Checked=Convert.ToBoolean(value);Result=Checked?"已选中":"未选中";}}}
