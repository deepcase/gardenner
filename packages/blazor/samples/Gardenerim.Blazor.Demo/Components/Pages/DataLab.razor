@page "/data"
@using System.Text.Json
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Rendering
@implements IAsyncDisposable
@inject IJSRuntime JS
<PageTitle>数据展示 · Blazor</PageTitle>
<h1>数据展示 · Blazor</h1>
<div style="max-width:1000px;display:grid;gap:16px">
<label>组件<select id="data-kind" @bind="Name" @bind:after="Reset">@foreach(var name in Names){<option>@name</option>}</select></label>
<label>变体<select id="data-variant" @bind="Mode"><option value="">默认</option>@foreach(var v in Variants.RootElement.GetProperty(Name).EnumerateArray()){<option>@v.GetString()</option>}</select></label>
<label>本地服务<select id="data-service" @bind="Service" @bind:after="ResetKeys"><option>success</option><option>retry</option><option>timeout</option><option>none</option></select></label>
<details><summary>参数组合</summary><div style="display:flex;flex-wrap:wrap;gap:12px">
<label>尺寸<select id="data-size" value="@Parameters.GetValueOrDefault("size","")" @onchange='e=>ParameterChanged("size",e)'><option value="">默认</option><option>small</option><option>medium</option><option>large</option></select></label>
<label>边框<select id="data-bordered" value="@Parameters.GetValueOrDefault("bordered","")" @onchange='e=>ParameterChanged("bordered",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>文件布局<select id="data-layout" value="@Parameters.GetValueOrDefault("layout","")" @onchange='e=>ParameterChanged("layout",e)'><option value="">默认</option><option>grid</option><option>list</option></select></label>
<label>标题<select id="data-showHeader" value="@Parameters.GetValueOrDefault("showHeader","")" @onchange='e=>ParameterChanged("showHeader",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>搜索<select id="data-showSearch" value="@Parameters.GetValueOrDefault("showSearch","")" @onchange='e=>ParameterChanged("showSearch",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>卡片说明<select id="data-showDescriptions" value="@Parameters.GetValueOrDefault("showDescriptions","")" @onchange='e=>ParameterChanged("showDescriptions",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>泳道数量<select id="data-showLaneCount" value="@Parameters.GetValueOrDefault("showLaneCount","")" @onchange='e=>ParameterChanged("showLaneCount",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>移动按钮<select id="data-showMoveControls" value="@Parameters.GetValueOrDefault("showMoveControls","")" @onchange='e=>ParameterChanged("showMoveControls",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>日历事件<select id="data-showCalendarEvents" value="@Parameters.GetValueOrDefault("showCalendarEvents","")" @onchange='e=>ParameterChanged("showCalendarEvents",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>今天按钮<select id="data-showToday" value="@Parameters.GetValueOrDefault("showToday","")" @onchange='e=>ParameterChanged("showToday",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>目录路径<select id="data-showBreadcrumbs" value="@Parameters.GetValueOrDefault("showBreadcrumbs","")" @onchange='e=>ParameterChanged("showBreadcrumbs",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>文件信息<select id="data-showFileMeta" value="@Parameters.GetValueOrDefault("showFileMeta","")" @onchange='e=>ParameterChanged("showFileMeta",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>查询结果<select id="data-showResults" value="@Parameters.GetValueOrDefault("showResults","")" @onchange='e=>ParameterChanged("showResults",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>导出预览<select id="data-showPreview" value="@Parameters.GetValueOrDefault("showPreview","")" @onchange='e=>ParameterChanged("showPreview",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>JSON 视图切换<select id="data-showModeSwitch" value="@Parameters.GetValueOrDefault("showModeSwitch","")" @onchange='e=>ParameterChanged("showModeSwitch",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>地图缩放按钮<select id="data-showZoomControls" value="@Parameters.GetValueOrDefault("showZoomControls","")" @onchange='e=>ParameterChanged("showZoomControls",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>面板最大高度<select id="data-maxHeight" value="@Parameters.GetValueOrDefault("maxHeight","")" @onchange='e=>ParameterChanged("maxHeight",e)'><option value="">默认</option><option>320</option><option>480</option><option>640</option></select></label>
<label>表格高度<select id="data-tableHeight" value="@Parameters.GetValueOrDefault("tableHeight","")" @onchange='e=>ParameterChanged("tableHeight",e)'><option value="">默认</option><option>160</option><option>320</option><option>480</option></select></label>
<label>泳道宽度<select id="data-laneWidth" value="@Parameters.GetValueOrDefault("laneWidth","")" @onchange='e=>ParameterChanged("laneWidth",e)'><option value="">默认</option><option>180</option><option>240</option><option>320</option></select></label>
<label>日历格高度<select id="data-calendarDayHeight" value="@Parameters.GetValueOrDefault("calendarDayHeight","")" @onchange='e=>ParameterChanged("calendarDayHeight",e)'><option value="">默认</option><option>44</option><option>64</option><option>88</option></select></label>
<label>地图高度<select id="data-mapHeight" value="@Parameters.GetValueOrDefault("mapHeight","")" @onchange='e=>ParameterChanged("mapHeight",e)'><option value="">默认</option><option>200</option><option>320</option><option>480</option></select></label>
<label>最多规则<select id="data-maxRules" value="@Parameters.GetValueOrDefault("maxRules","")" @onchange='e=>ParameterChanged("maxRules",e)'><option value="">默认</option><option>1</option><option>3</option><option>10</option></select></label>
<label>预览条数<select id="data-exportPreviewRows" value="@Parameters.GetValueOrDefault("exportPreviewRows","")" @onchange='e=>ParameterChanged("exportPreviewRows",e)'><option value="">默认</option><option>0</option><option>5</option><option>20</option></select></label>
<label>加载超时<select id="data-serviceTimeout" value="@Parameters.GetValueOrDefault("serviceTimeout","")" @onchange='e=>ParameterChanged("serviceTimeout",e)'><option value="">默认</option><option>200</option><option>1000</option><option>60000</option></select></label>
</div></details>
<button id="data-resize" class="g-btn" @onclick="ToggleSize">切换尺寸</button>
<div id="data-scope" @key="@(Name+Service)" style="min-width:0">@Fixture</div>
<output id="data-state" style="overflow-wrap:anywhere">@Result</output>
<p>全部 52 个组件及 252 个变体。静态结构通过 ChildContent，网格通过 gridOptions，13 个托管组件通过 dataOptions 配置；本地服务仅作演示。</p>
</div>
