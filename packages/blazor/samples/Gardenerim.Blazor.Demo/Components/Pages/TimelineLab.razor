@page "/timeline"
@using System.Text.Json
<PageTitle>GTimeline</PageTitle>
<section style="max-width:800px;margin:24px auto;padding:16px"><h1>GTimeline</h1><label>方向 <select aria-label="方向" @bind="Direction"><option>vertical</option><option>horizontal</option></select></label><label><input type="checkbox" @bind="Reverse" />倒序</label><button type="button" @onclick="Add">添加事件</button><div style="padding:24px;border:1px solid var(--g-color-border);margin-block:16px"><GTimeline id="timeline" Config="Config" EventNames="@(new[]{"action"})" OnEvent="Handle" /></div><output aria-live="polite">@Result</output></section>
@code{private string Direction="vertical",Result="尚未操作";private bool Reverse;private int Counter=3;private List<TimelineEvent> Items=[new("one","创建项目","09:00"),new("two","发布版本","12:00")];private record TimelineEvent(string key,string content,string label){public object[] actions=>[new{key="open",label="查看详情"}];}private IReadOnlyDictionary<string,object?> Config=>new Dictionary<string,object?>{["data-options"]=JsonSerializer.Serialize(new{items=Items,direction=Direction,reverse=Reverse,pending="处理中…",responsive=true})};private void Add(){var key=(Counter++).ToString();Items.Add(new(key,"新增事件 "+key,"刚刚"));}private void Handle(Gardenerim.Blazor.Models.GardenerimEventArgs e){if(e.Detail is IReadOnlyDictionary<string,object?> d&&d.TryGetValue("key",out var key))Result="事件 "+key;}}
