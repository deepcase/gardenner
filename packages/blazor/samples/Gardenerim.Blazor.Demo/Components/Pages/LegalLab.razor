@page "/legal"
@using System.Text.Json
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>法律 组件 · Blazor</PageTitle>
<link rel="stylesheet" href="legal-demo.css" />
<h1>法律 组件 · Blazor</h1>
<p>同意、协议、政策文档与隐私请求；使用本地模拟服务。</p>
<label>组件<select id="legal-kind" @bind="Name" @bind:after="Reset">@foreach(var name in Names){<option>@name</option>}</select></label>
<label>变体<select id="legal-mode" @bind="Mode" @bind:after="ResetState">@foreach(var mode in Examples.RootElement.GetProperty(Name).EnumerateObject()){<option>@mode.Name</option>}</select></label>

<button class="g-btn" id="legal-size" @onclick="ToggleSize">切换尺寸</button>
<div class="legal-demo-host"><GardenerimComponent @key="Name+Mode" Name="@Name" Variant="@Mode" Config="Options" EventNames="@(new[]{"change","action","complete","error"})" OnEvent="Changed" id="legal-root" /><output class="legal-demo-result"></output><output id="legal-state">@Result</output></div>
