@page "/foundations"
@using System.Text.Json
<PageTitle>Gardenerim 对照组件</PageTitle>
<div id="foundation-lab" style="padding:24px"><h1>Gardenerim 对照组件</h1><label>尺寸 <select aria-label="尺寸" @bind="Size"><option>mini</option><option>small</option><option>medium</option><option>large</option></select></label><label><input type="checkbox" @bind="Disabled" />禁用输入</label><output aria-live="polite" style="display:block;overflow-wrap:anywhere;margin-block:12px">@Result</output><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:24px">
@foreach(var name in Names){<section style="min-width:0;padding:16px;border:1px solid var(--g-color-border)"><h2 style="font-size:18px">@name</h2><GardenerimComponent @key="name" Name="@name" id="@("blazor-"+name)" Config="@Config(name)" EventNames="@(new[]{"change"})" OnEvent="Handle">@if(name=="scrollbar"){for(var i=0;i<20;i++){<p>资源 @i</p>}}else if(name=="space"){<button type="button">保存</button><button type="button">取消</button>}else if(name=="link"){<span>文档</span>}else if(name=="watermark"||name=="resize-box"||name=="affix"){<p>可交互的原始内容</p><button type="button">操作</button>}</GardenerimComponent></section>}
</div></div>
@code {
private string Size="medium",Result="等待交互";private bool Disabled;
private readonly string[] Names=new[]{"affix","resize-box","scrollbar","space","watermark","overflow-list","input-number","input-tag","color-picker","link","typography","icon"};
private readonly Dictionary<string,Dictionary<string,object?>> Options=JsonSerializer.Deserialize<Dictionary<string,Dictionary<string,object?>>>("""
{"input-number":{"defaultValue":3,"min":0,"max":100,"step":0.5,"precision":1,"allowClear":true,"label":"数量"},"input-tag":{"defaultValue":["设计","开发"],"maxTagCount":5,"label":"标签"},"color-picker":{"defaultValue":"#19b27dcc","alpha":true,"presets":["#19b27d","#165dff","#722ed1"],"label":"主题色"},"affix":{"offsetTop":8},"resize-box":{"defaultWidth":280,"defaultHeight":160,"minWidth":120,"maxWidth":600,"minHeight":80,"maxHeight":320},"scrollbar":{"height":160,"label":"资源列表"},"space":{"gap":12,"wrap":true},"watermark":{"content":"Gardenerim\n内部资料"},"overflow-list":{"items":[{"key":0,"label":"资源 1"},{"key":1,"label":"资源 2"},{"key":2,"label":"资源 3"},{"key":3,"label":"资源 4"},{"key":4,"label":"资源 5"},{"key":5,"label":"资源 6"},{"key":6,"label":"资源 7"},{"key":7,"label":"资源 8"}],"maxVisible":3},"link":{"href":"#foundation-documentation","underline":true},"typography":{"text":"Gardenerim 使用统一的颜色、字体和间距表达清晰的信息层级。Gardenerim 使用统一的颜色、字体和间距表达清晰的信息层级。Gardenerim 使用统一的颜色、字体和间距表达清晰的信息层级。Gardenerim 使用统一的颜色、字体和间距表达清晰的信息层级。Gardenerim 使用统一的颜色、字体和间距表达清晰的信息层级。Gardenerim 使用统一的颜色、字体和间距表达清晰的信息层级。Gardenerim 使用统一的颜色、字体和间距表达清晰的信息层级。Gardenerim 使用统一的颜色、字体和间距表达清晰的信息层级。Gardenerim 使用统一的颜色、字体和间距表达清晰的信息层级。Gardenerim 使用统一的颜色、字体和间距表达清晰的信息层级。","ellipsis":2,"copyable":true},"icon":{"icon":"✓","label":"完成","iconSize":24}}
""")!;
private IReadOnlyDictionary<string,object?> Config(string name){var o=new Dictionary<string,object?>(Options[name]){["size"]=Size};if(name is "input-number" or "input-tag" or "color-picker")o["disabled"]=Disabled;return new Dictionary<string,object?>{["foundation-options"]=JsonSerializer.Serialize(o)};}
private void Handle(Gardenerim.Blazor.Models.GardenerimEventArgs e){Result=JsonSerializer.Serialize(e.Detail);}
}
