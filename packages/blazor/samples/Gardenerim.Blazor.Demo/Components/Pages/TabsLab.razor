@page "/tabs"
@using System.Text.Json
<PageTitle>GTabs</PageTitle>
<main style="max-width:800px;margin:24px auto;padding:16px"><h1>GTabs</h1><label>类型 <select aria-label="类型" @bind="Type">@foreach(var value in new[]{"line","card","card-gutter","text","rounded","capsule"}){<option>@value</option>}</select></label><label>尺寸 <select aria-label="尺寸" @bind="Size">@foreach(var value in new[]{"mini","small","medium","large"}){<option>@value</option>}</select></label><div style="padding:20px;margin-block:24px;border:1px solid var(--g-color-border)"><GTabs id="tabs" Config="Config" EventNames="@(new[]{"change","add","remove"})" OnEvent="Handle" /></div><output aria-live="polite">@Result</output></main>
@code{private string Type="line",Size="medium",Result="尚未切换";private int Counter=3;private List<Tab> Items=[new("one","项目一","项目一的内容",false),new("two","项目二","项目二的内容",true)];private record Tab(string key,string title,string content,bool closable);private IReadOnlyDictionary<string,object?> Config=>new Dictionary<string,object?>{["tabs-options"]=JsonSerializer.Serialize(new{items=Items,type=Type,size=Size,editable=true,showAddButton=true,autoSwitch=true,addLabel="新增项目",closeLabel="关闭"})};private void Handle(Gardenerim.Blazor.Models.GardenerimEventArgs e){if(e.EventName.Replace("gardener:","")=="add"){var key=(Counter++).ToString();Items.Add(new(key,"项目 "+key,"项目 "+key+" 的内容",true));}else if(e.Detail is IReadOnlyDictionary<string,object?> detail&&detail.TryGetValue("key",out var value)){var key=value?.ToString();if(e.EventName.Replace("gardener:","")=="remove")Items.RemoveAll(x=>x.key==key);else if(e.EventName.Replace("gardener:","")=="change")Result="当前标签 "+key;}}}
