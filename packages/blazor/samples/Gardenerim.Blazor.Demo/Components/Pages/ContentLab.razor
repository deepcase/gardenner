@page "/content"
@using System.Text.Json
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>内容组件 · Blazor</PageTitle>
<h1>内容组件 · Blazor</h1>
<div style="max-width:920px;display:grid;gap:16px">
<label>组件<select id="content-kind" class="g-select" @bind="Name" @bind:after="Reset">@foreach(var name in Names){<option>@name</option>}</select></label>
<label>变体<select id="content-variant" @bind="Mode"><option value="">默认</option>@foreach(var v in Variants.RootElement.GetProperty(Name).EnumerateArray()){<option>@v.GetString()</option>}</select></label>
<label>本地服务<select id="content-service" @bind="Service" @bind:after="ResetState"><option>success</option><option>retry</option><option>timeout</option><option>none</option></select></label>
<label>showHeader <select id="content-showHeader" value="@Parameters.GetValueOrDefault("showHeader","")" @onchange='e=>ParameterChanged("showHeader",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>showToolbar <select id="content-showToolbar" value="@Parameters.GetValueOrDefault("showToolbar","")" @onchange='e=>ParameterChanged("showToolbar",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>showCount <select id="content-showCount" value="@Parameters.GetValueOrDefault("showCount","")" @onchange='e=>ParameterChanged("showCount",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>showPagination <select id="content-showPagination" value="@Parameters.GetValueOrDefault("showPagination","")" @onchange='e=>ParameterChanged("showPagination",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>showMetadata <select id="content-showMetadata" value="@Parameters.GetValueOrDefault("showMetadata","")" @onchange='e=>ParameterChanged("showMetadata",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>showDescriptions <select id="content-showDescriptions" value="@Parameters.GetValueOrDefault("showDescriptions","")" @onchange='e=>ParameterChanged("showDescriptions",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>showSort <select id="content-showSort" value="@Parameters.GetValueOrDefault("showSort","")" @onchange='e=>ParameterChanged("showSort",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>showViewSwitcher <select id="content-showViewSwitcher" value="@Parameters.GetValueOrDefault("showViewSwitcher","")" @onchange='e=>ParameterChanged("showViewSwitcher",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>showUploadHints <select id="content-showUploadHints" value="@Parameters.GetValueOrDefault("showUploadHints","")" @onchange='e=>ParameterChanged("showUploadHints",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>showChunkDetails <select id="content-showChunkDetails" value="@Parameters.GetValueOrDefault("showChunkDetails","")" @onchange='e=>ParameterChanged("showChunkDetails",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>showCopy <select id="content-showCopy" value="@Parameters.GetValueOrDefault("showCopy","")" @onchange='e=>ParameterChanged("showCopy",e)'><option value="">默认</option><option>true</option><option>false</option></select></label>
<label>editorRows <select id="content-editorRows" value="@Parameters.GetValueOrDefault("editorRows","")" @onchange='e=>ParameterChanged("editorRows",e)'><option value="">默认</option><option>3</option><option>6</option><option>10</option></select></label>
<label>maxHeight <select id="content-maxHeight" value="@Parameters.GetValueOrDefault("maxHeight","")" @onchange='e=>ParameterChanged("maxHeight",e)'><option value="">默认</option><option>240</option><option>400</option><option>640</option></select></label>
<label>previewHeight <select id="content-previewHeight" value="@Parameters.GetValueOrDefault("previewHeight","")" @onchange='e=>ParameterChanged("previewHeight",e)'><option value="">默认</option><option>240</option><option>400</option><option>640</option></select></label>
<label>columns <select id="content-columns" value="@Parameters.GetValueOrDefault("columns","")" @onchange='e=>ParameterChanged("columns",e)'><option value="">默认</option><option>1</option><option>2</option><option>3</option><option>4</option></select></label>
<label>thumbnailSize <select id="content-thumbnailSize" value="@Parameters.GetValueOrDefault("thumbnailSize","")" @onchange='e=>ParameterChanged("thumbnailSize",e)'><option value="">默认</option><option>32</option><option>48</option><option>80</option></select></label>
<label>serviceTimeout <select id="content-serviceTimeout" value="@Parameters.GetValueOrDefault("serviceTimeout","")" @onchange='e=>ParameterChanged("serviceTimeout",e)'><option value="">默认</option><option>1000</option><option>5000</option><option>60000</option></select></label>
<label>resize <select id="content-editor-resize" value="@Parameters.GetValueOrDefault("resize","")" @onchange='e=>ParameterChanged("resize",e)'><option value="">默认</option><option>none</option><option>vertical</option><option>both</option></select></label>
<button id="content-resize" class="g-btn" @onclick="ToggleSize">切换尺寸</button>
<GardenerimComponent @key="Name+Service" Name="@Name" Variant="@Mode" data-demo-content-service="@Service" Config="Options" EventNames="@(new[]{"change","action","error"})" OnEvent="Changed" id="content-root" />
<output id="content-state" style="overflow-wrap:anywhere">@Result</output>
<p>39 个真实 Blazor 组件。上传和保存使用本地演示服务；状态变化由 Blazor 回写。</p>
</div>
