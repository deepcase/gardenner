private static readonly string[] Names=Examples.RootElement.EnumerateObject().Select(p=>p.Name).ToArray();
private string Name{get;set;}="grid-system";private string Mode{get;set;}="24-column";private string State=JsonSerializer.Serialize(new{collapsed=false});private int Gap=16;
private Dictionary<string,string> Parameters=new();
private void ParameterChanged(string key,ChangeEventArgs args){Parameters[key]=args.Value?.ToString()??"";}
private JsonElement Fixture=>Examples.RootElement.GetProperty(Name).GetProperty(Mode);
private IReadOnlyDictionary<string,object?> Options {get {var options=JsonSerializer.Deserialize<Dictionary<string,object?>>(Fixture.GetProperty("options").GetRawText())!;options["gap"]=Gap;foreach(var pair in Parameters){if(pair.Value=="")continue;options[pair.Key]=bool.TryParse(pair.Value,out var flag)?(object)flag:int.TryParse(pair.Value,out var number)?(object)number:pair.Value;}return new Dictionary<string,object?>{["layoutOptions"]=JsonSerializer.Serialize(options),["layoutValue"]=State,["layoutDisabled"]=false};}}
private void Reset(){Mode=Examples.RootElement.GetProperty(Name).EnumerateObject().First().Name;ResetState();}
private void ResetState(){Parameters.Clear();State=JsonSerializer.Serialize(new{collapsed=Mode=="collapsed"});}
private void Changed(Gardenerim.Blazor.Models.GardenerimEventArgs args){if(args.EventName=="gardener:change"&&args.Detail is IReadOnlyDictionary<string,object?> values&&values.TryGetValue("value",out var value))State=JsonSerializer.Serialize(value);}
