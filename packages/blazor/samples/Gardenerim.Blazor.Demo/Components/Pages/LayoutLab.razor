@page "/layout"
@using System.Text.Json
<PageTitle>布局组件 · Blazor</PageTitle>
<link rel="stylesheet" href="layout-demo.css" />
<h1 id="layout-intro">布局组件 · Blazor</h1>
<div style="max-width:1100px">
<label>组件<select id="layout-kind" @bind="Name" @bind:after="Reset">@foreach(var name in Names){<option>@name</option>}</select></label>
<label>模式<select id="layout-mode" @bind="Mode" @bind:after="ResetState">@foreach(var mode in Examples.RootElement.GetProperty(Name).EnumerateObject()){<option>@mode.Name</option>}</select></label>
<label>纵向内距<select id="layout-paddingBlock" value="@Parameters.GetValueOrDefault("paddingBlock","")" @onchange='e=>ParameterChanged("paddingBlock",e)'><option value="">跟随模式</option><option value="4">4</option><option value="8">8</option><option value="16">16</option><option value="24">24</option></select></label>
<label>横向内距<select id="layout-paddingInline" value="@Parameters.GetValueOrDefault("paddingInline","")" @onchange='e=>ParameterChanged("paddingInline",e)'><option value="">跟随模式</option><option value="8">8</option><option value="12">12</option><option value="16">16</option><option value="24">24</option></select></label>
<label>最大高度<select id="layout-maxHeight" value="@Parameters.GetValueOrDefault("maxHeight","")" @onchange='e=>ParameterChanged("maxHeight",e)'><option value="">跟随模式</option><option value="240">240</option><option value="360">360</option><option value="480">480</option></select></label>
<label>网格行高<select id="layout-autoRows" value="@Parameters.GetValueOrDefault("autoRows","")" @onchange='e=>ParameterChanged("autoRows",e)'><option value="">跟随模式</option><option value="64">64</option><option value="80">80</option><option value="120">120</option></select></label>
<label>窄屏列数<select id="layout-narrowColumns" value="@Parameters.GetValueOrDefault("narrowColumns","")" @onchange='e=>ParameterChanged("narrowColumns",e)'><option value="">跟随模式</option><option value="1">1</option><option value="2">2</option><option value="3">3</option></select></label>
<label>内容对齐<select id="layout-alignContent" value="@Parameters.GetValueOrDefault("alignContent","")" @onchange='e=>ParameterChanged("alignContent",e)'><option value="">跟随模式</option><option value="start">start</option><option value="center">center</option><option value="end">end</option><option value="stretch">stretch</option><option value="space-between">space-between</option></select></label>
<label>网格项对齐<select id="layout-justifyItems" value="@Parameters.GetValueOrDefault("justifyItems","")" @onchange='e=>ParameterChanged("justifyItems",e)'><option value="">跟随模式</option><option value="start">start</option><option value="center">center</option><option value="end">end</option><option value="stretch">stretch</option></select></label>
<label>Escape 收起<select id="layout-closeOnEscape" value="@Parameters.GetValueOrDefault("closeOnEscape","")" @onchange='e=>ParameterChanged("closeOnEscape",e)'><option value="">跟随模式</option><option value="true">true</option><option value="false">false</option></select></label>
<label>允许收起<select id="layout-collapsible" value="@Parameters.GetValueOrDefault("collapsible","")" @onchange='e=>ParameterChanged("collapsible",e)'><option value="">跟随模式</option><option value="true">true</option><option value="false">false</option></select></label>
<label>收起后返回焦点<select id="layout-focusOnCollapse" value="@Parameters.GetValueOrDefault("focusOnCollapse","")" @onchange='e=>ParameterChanged("focusOnCollapse",e)'><option value="">跟随模式</option><option value="true">true</option><option value="false">false</option></select></label>
<button class="g-btn" id="layout-gap" @onclick="()=>Gap=Gap==16?24:16">切换间距</button>
<div class="layout-demo-host">
<GardenerimComponent @key="Name+Mode" Name="@Name" Variant="@Mode" Config="Options" EventNames="@(new[]{"change","error"})" OnEvent="Changed" id="layout-root">@((MarkupString)Fixture.GetProperty("body").GetString()!)</GardenerimComponent>
</div><output id="layout-state">@State</output></div>
