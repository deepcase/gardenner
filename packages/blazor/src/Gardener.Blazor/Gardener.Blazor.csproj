<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Gardener.Blazor</AssemblyName>
    <RootNamespace>Gardener.Blazor</RootNamespace>
    <Version>1.0.0</Version>
    <PackageId>Gardener.Blazor</PackageId>
    <Title>Gardener Blazor</Title>
    <Description>Official .NET 10 Blazor component bindings for the Gardener CSS framework, compatible with .NET 11 applications.</Description>
    <Authors>Gardener contributors</Authors>
    <PackageTags>blazor;razor-components;css-framework;design-system;dashboard;mobile;ai-ui;tauri;electron</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\**\*" Pack="true" PackagePath="docs\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\metadata\**\*" Pack="true" PackagePath="metadata\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
